{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BillPouch",
  "version": "0.3.3",
  "identifier": "io.billpouch.app",
  "build": {
    "frontendDist": "../crates/bp-api/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BillPouch"
      }
